{
    "drop_columns": [
        "departamento", "municipio", "date", "cod_muni", "tipo",
        "casosconfirmados",
        "umbral_li", "umbral_ls",
        "nivel_riesgo_label"
    ],
    "average_pairs": [
        {
            "new_column": "temp_avg",
            "columns": ["tempmax", "tempmin"],
            "drop_originals": true
        },
        {
            "new_column": "temp_avg_lag1",
            "columns": ["tempmax_lag1", "tempmin_lag1"],
            "drop_originals": true
        },
        {
            "new_column": "temp_avg_lag2",
            "columns": ["tempmax_lag2", "tempmin_lag2"],
            "drop_originals": true
        },
        {
            "new_column": "temp_avg_lag3",
            "columns": ["tempmax_lag3", "tempmin_lag3"],
            "drop_originals": true
        }
    ],
    "rename_columns": {},
    "pca_groups": [
        {
            "columns": ["dew_point", "dew_point_lag1", "dew_point_lag2", "dew_point_lag3"],
            "n_components": 1,
            "prefix": "pca_dew_point",
            "drop_originals": true
        },
        {
            "columns": ["casos_lag1", "casos_lag2", "casos_lag3"],
            "n_components": 1,
            "prefix": "pca_casos_lags",
            "drop_originals": true
        },
        {
            "columns": ["riesgo_lag1", "riesgo_lag2", "riesgo_lag3"],
            "n_components": 1,
            "prefix": "pca_riesgo_lags",
            "drop_originals": true
        },
        {
            "columns": ["temp_avg", "temp_avg_lag1", "temp_avg_lag2", "temp_avg_lag3"],
            "n_components": 1,
            "prefix": "pca_temp_avg",
            "drop_originals": true
        },
        {
            "columns": [
                "fenomeno_nina_mod", "fenomeno_nina_sev", "fenomeno_nino_mod", "fenomeno_nino_sev",
                "fenomeno_lag1_nina_mod", "fenomeno_lag1_nina_sev", "fenomeno_lag1_nino_mod", "fenomeno_lag1_nino_sev",
                "fenomeno_lag2_nina_mod", "fenomeno_lag2_nina_sev", "fenomeno_lag2_nino_mod", "fenomeno_lag2_nino_sev",
                "fenomeno_lag3_nina_mod", "fenomeno_lag3_nina_sev", "fenomeno_lag3_nino_mod", "fenomeno_lag3_nino_sev"
            ],
            "n_components": 2,
            "prefix": "pca_enso",
            "drop_originals": true
        }
    ],
    "notes": "CONFIG A (actual): tempmax+tempmin promediados en temp_avg, luego PCA con lags a 1 componente (pca_temp_avg_1). Dataset final: 22 columnas."
}
